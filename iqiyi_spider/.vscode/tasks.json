{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "运行爬虫（图形界面）",
      "type": "shell",
      "command": "python",
      "args": ["main.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "命令行抓取示例",
      "type": "shell",
      "command": "python",
      "args": ["cli.py", "狂飙", "--pages", "3"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "运行测试",
      "type": "shell",
      "command": "python",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
